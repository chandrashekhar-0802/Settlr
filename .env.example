# Copy to .env.local and fill in. NEVER commit .env.local.
# Leave the Supabase values empty to run Settlr in demo mode (sample data, browser-only storage).

# Public: safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public: canonical site URL used for metadata, sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only: transactional emails via Resend. Unset = in-app confirmations only.
RESEND_API_KEY=
RESEND_FROM=
