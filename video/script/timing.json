 "lines": [
  {
   "id": "s1",
   "start": 0.3,
   "dur": 9.173,
   "en": "Got the job? Congratulations! But now there's a whole new city to figure out. A place to stay, food, and the way to the office. All on your own."
  },
  {
   "id": "s2",
   "start": 11.073,
   "dur": 4.245,
   "en": "Meet Settlr. New job. New city. Everything sorted. Starting in Pune."
  },
  {
   "id": "s3",
   "start": 16.919,
   "dur": 5.931,
   "en": "Just answer a few questions: which city, where your office is, when you're moving, and your monthly budget."
  },
  {
   "id": "s4",
   "start": 24.449,
   "dur": 9.877,
   "en": "Settlr shows PGs and flats near your office, tiffin services, and commute options, with distance and cost. Filter them, save them, and compare them."
  },
  {
   "id": "s5",
   "start": 35.927,
   "dur": 8.619,
   "en": "Your plan keeps every cost separate: monthly, one-time, and deposits. If your PG includes meals, you never pay for a tiffin twice."
  },
  {
   "id": "s6",
   "start": 46.145,
   "dur": 4.501,
   "en": "A checklist built around your move date, and your whole move on one dashboard."
  },
  {
   "id": "s7",
   "start": 55.136,
   "dur": 3.264,
   "en": "Settlr. Your new job. Your new city. Everything sorted."
  }
 ],
